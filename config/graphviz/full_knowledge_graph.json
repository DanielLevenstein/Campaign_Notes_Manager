{
  "schema_version": "0.1.0",
  "config_scope": "knowledge_view",
  "view_key": "full_knowledge_graph",
  "label": "Full Knowledge Graph",
  "description": "Full combined graph view for all uploaded character, place, and session-note lore, with optional source-file and heading hiding controls.",
  "inherits": "config/graphviz/global_graph_view.json",
  "merge_order": [
    "config/graphviz/global_graph_view.json",
    "config/graphviz/full_knowledge_graph.json"
  ],
  "graph": {
    "rankdir": "LR",
    "vertical_rankdir": "TB"
  },
  "spacing": {
    "small_graph": {
      "max_nodes": 8,
      "ranksep": 1.15,
      "nodesep": 0.4
    },
    "column_layout": {
      "ranksep": 0.75,
      "nodesep": 0.4
    },
    "vertical_layout": {
      "ranksep": 0.65,
      "nodesep": 0.35
    },
    "default": {
      "ranksep": 0.75,
      "nodesep": 0.4
    }
  },
  "columns": [
    ["source_files", "h1"],
    ["h2"],
    ["h3"],
    ["places"],
    ["groups","family_names", "artifacts"],
    ["main_characters"],
    ["secondary_characters"]
  ],
  "editing_notes": [
    "This view renders the full combined graph across uploaded lore sources.",
    "The Streamlit controls can hide source file nodes and H1-H3 heading nodes without changing this column layout."
  ]
}
