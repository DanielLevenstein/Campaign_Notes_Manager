      "group": "\\b(?:(?:the|The)\\s+)?(?:(?P<of>cult)\\s+of\\s+(?P<of_name>[A-Z][A-Za-z]+)|(?P<prefix>[A-Z][A-Za-z]+)\\s+(?P<suffix>cult))\\b",
      "family_heading": "^\\s{0,3}#{1,6}\\s+(?:The\\s+)?(?P<name>[A-Z][A-Za-z]+)\\s+Family\\b",
      "sentence": "[^.!?\\n]+[.!?]?"
