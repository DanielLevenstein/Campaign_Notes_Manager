    "School",
    "Sea",
    "Shore",
    "Shores",
    "Temple",
    "Tower",
    "Tavern",
    "University",
    "Village"
  ],
  "motivation_patterns": [
    "\\b(?:wants|seeks|hopes|needs|tries|trying|adventures)\\s+to\\s+([^.!?;]+)",
    "\\b(?:goal|motivation)\\s+(?:is|was)\\s+to\\s+([^.!?;]+)"
  ],
  "relationship_rules": [
    {
      "type": "betrayer",
      "label": "Betrayer",
