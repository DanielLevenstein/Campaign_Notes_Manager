{
  "schema_version": "0.3.0",
  "normalization": {
    "schema_version": "0.3.0",
    "descriptor_suffixes": [
      "Lore",
      "Investigation",
      "Investigations",
      "Note",
      "Notes",
      "Report",
      "Reports"
    ],
    "type_precedence": {
      "source_document": 50,
      "note": 45,
      "place": 40,
      "group": 30,
      "family": 25,
      "artifact": 20,
      "character": 10,
      "attribute": 5,
      "entity": 0
    }
  },
  "patterns": {
    "name": "\\b([A-Z][a-z]+(?:[ \\t]+(?:the[ \\t]+)?[A-Z][a-z]+){0,3})\\b",
    "heading": "^#\\s+(.+?)\\s*$",
    "sentence": "[^.!?\\n]+[.!?]?"
  },
  "honorific_words": ["Dr", "Miss", "Mr", "Mrs", "Ms", "Mx"],
  "unknown_values": ["", "unknown", "none", "n/a", "na", "unspecified", "not specified", "tbd"],
  "non_name_words": [
    "A",
    "An",
    "And",
    "As",
    "At",
    "But",
    "By",
    "For",
    "From",
    "Haunted",
