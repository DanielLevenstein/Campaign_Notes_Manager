  "patterns": {
    "name": "\\b([A-Z][a-z]+(?:[ \\t]+(?:the[ \\t]+)?[A-Z][a-z]+){0,3})\\b",
    "heading": "^#\\s+(.+?)\\s*$",
    "sentence": "[^.!?\\n]+[.!?]?"
  },
